# Application settings of the test stacks (thesis proposal, section 3.2.3).
# MariaDB, OPcache and cpuset settings are not part of this file.
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=error

CACHE_STORE=null
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# The Query Builder implementation fires no model event and writes no activity log
ACTIVITYLOG_ENABLED=false

RESEARCH_API_TOKEN=research-load-test-token
