# Copy to .env in the checkout of each implementation, for docker-compose.research.yml.
# Active Record: research-ar, 8001. Repository: research-repo, 8002. Query Builder: research-qb, 8003.
COMPOSE_PROJECT_NAME=research-ar
APP_PORT=8001

# Use the same value on the three stacks
APP_KEY=

APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=error

CACHE_STORE=null
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# The Query Builder implementation fires no model event and writes no activity log
ACTIVITYLOG_ENABLED=false

# Read by ResearchSeeder when the dump is created. The dump then holds this token.
RESEARCH_API_TOKEN=research-load-test-token
