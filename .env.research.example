# Copy to .env in the checkout of each implementation, for docker-compose.research.yml.
# Active Record: research-ar, 8001. Repository: research-repo, 8002. Query Builder: research-qb, 8003.
COMPOSE_PROJECT_NAME=research-ar
APP_PORT=8001

# Use the same value on the three stacks
APP_KEY=

APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=error

# No application cache (table 3.4), no queue worker. The research pages log users in
# with a session in the database, the default of academico, as on the real pages.
CACHE_STORE=null
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# The endpoints under test write no activity log in any implementation
ACTIVITYLOG_ENABLED=false

# Read by ResearchSeeder when the dump is created. The dump then holds this token.
# Student tokens are generated by the seeder and are part of the dump.
RESEARCH_API_TOKEN=research-load-test-token
